          "type": "number"
        },
        "q_change_limit_mvar_per_cycle": {
          "minimum": 0,
          "title": "Q Change Limit Mvar Per Cycle",
          "type": "number"
        },
        "settling_resolution": {
          "exclusiveMinimum": 0,
          "maximum": 0.001,
          "title": "Settling Resolution",
          "type": "number"
        },
        "voltage_min_pu": {
          "exclusiveMinimum": 0,
          "title": "Voltage Min Pu",
          "type": "number"
        },
        "voltage_max_pu": {
          "exclusiveMinimum": 0,
          "title": "Voltage Max Pu",
          "type": "number"
        },
        "pcc_min_mw": {
          "minimum": 0,
          "title": "Pcc Min Mw",
          "type": "number"
        },
        "pcc_max_mw": {
          "exclusiveMinimum": 0,
          "title": "Pcc Max Mw",
          "type": "number"
        },
        "pf_min": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Pf Min",
          "type": "number"
        },
        "telemetry_max_age_seconds": {
          "exclusiveMinimum": 0,
          "title": "Telemetry Max Age Seconds",
          "type": "number"
        },
        "snapshot_max_skew_seconds": {
          "minimum": 0,
          "title": "Snapshot Max Skew Seconds",
          "type": "number"
        },
        "future_clock_skew_seconds": {
          "minimum": 0,
          "title": "Future Clock Skew Seconds",
          "type": "number"
        },
        "compute_budget_seconds": {
          "exclusiveMinimum": 0,
          "title": "Compute Budget Seconds",
          "type": "number"
        },
        "dispatch_lead_seconds": {
          "minimum": 0,
          "title": "Dispatch Lead Seconds",
          "type": "number"
        },
        "transport_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Transport Timeout Seconds",
          "type": "number"
        },
        "feedback_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Feedback Timeout Seconds",
          "type": "number"
        },
        "model_error_policy_ref": {
          "enum": [
            "exact-normalized-snapshot-v1",
            "bounded-observation-v1"
          ],
          "title": "Model Error Policy Ref",
          "type": "string"
        },
        "availability_method_ref": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Availability Method Ref",
          "type": "string"
        },
        "local_fallback_policy_ref": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Local Fallback Policy Ref",
          "type": "string"
        }
      },
      "required": [
        "execution_step_seconds",
        "planning_update_seconds",
        "planning_horizon_seconds",
        "response_deadline_seconds",
        "p_tracking_tolerance_mw",
        "q_tracking_tolerance_mvar",
        "pcc_model_tolerance_mw",
        "pcc_model_tolerance_mvar",
        "alpha_q",
        "q_change_limit_mvar_per_cycle",
        "settling_resolution",
        "voltage_min_pu",
        "voltage_max_pu",
        "pcc_min_mw",
        "pcc_max_mw",
        "pf_min",
        "telemetry_max_age_seconds",
        "snapshot_max_skew_seconds",
        "future_clock_skew_seconds",
        "compute_budget_seconds",
        "dispatch_lead_seconds",
        "transport_timeout_seconds",
        "feedback_timeout_seconds",
        "model_error_policy_ref",
        "availability_method_ref",
        "local_fallback_policy_ref"
