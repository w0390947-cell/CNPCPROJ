        },
        "q_tracking_tolerance_mvar": {
          "exclusiveMinimum": 0,
          "title": "Q Tracking Tolerance Mvar",
          "type": "number"
        },
        "pcc_model_tolerance_mw": {
          "minimum": 0,
          "title": "Pcc Model Tolerance Mw",
          "type": "number"
        },
        "pcc_model_tolerance_mvar": {
          "minimum": 0,
          "title": "Pcc Model Tolerance Mvar",
          "type": "number"
        },
        "alpha_q": {
          "exclusiveMinimum": 0,
          "maximum": 1,
