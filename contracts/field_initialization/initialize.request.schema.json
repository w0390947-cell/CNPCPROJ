{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "Authority": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Owner Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "permission_revision": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Permission Revision",
          "type": "string"
        },
        "write_enabled": {
          "default": false,
          "title": "Write Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "owner_id",
        "epoch",
        "valid_until",
        "permission_revision"
      ],
      "title": "Authority",
      "type": "object"
    },
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Resource Id",
          "type": "string"
        },
        "available_p_mw": {
          "$ref": "#/$defs/MeasuredValue"
        },
        "method_ref": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method Ref",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "available_p_mw",
        "method_ref"
      ],
      "title": "Availability",
      "type": "object"
    },
    "BoundedTimingPolicy": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "bounded_monotone_v1",
            "bounded_uncertain_v1"
          ],
          "title": "Profile",
          "type": "string"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        },
        "provenance_ref": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provenance Ref",
          "type": "string"
        },
        "response_semantics": {
          "enum": [
            "monotone_no_overshoot_exact_settling",
            "monotone_no_overshoot_bounded_settling"
          ],
          "title": "Response Semantics",
          "type": "string"
        },
        "clock_error_bound_seconds": {
          "minimum": 0,
          "title": "Clock Error Bound Seconds",
          "type": "number"
        },
        "prepare_max_seconds": {
          "exclusiveMinimum": 0,
          "title": "Prepare Max Seconds",
          "type": "number"
        },
        "transport_max_seconds": {
          "exclusiveMinimum": 0,
          "title": "Transport Max Seconds",
          "type": "number"
        },
        "apply_not_before_seconds": {
          "exclusiveMinimum": 0,
          "title": "Apply Not Before Seconds",
          "type": "number"
        },
        "apply_not_after_seconds": {
          "exclusiveMinimum": 0,
          "title": "Apply Not After Seconds",
          "type": "number"
        },
        "application_skew_max_seconds": {
          "minimum": 0,
          "title": "Application Skew Max Seconds",
          "type": "number"
        },
        "snapshot_delivery_max_seconds": {
          "exclusiveMinimum": 0,
          "title": "Snapshot Delivery Max Seconds",
          "type": "number"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceTiming"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "revision",
        "provenance_ref",
        "response_semantics",
        "clock_error_bound_seconds",
        "prepare_max_seconds",
        "transport_max_seconds",
        "apply_not_before_seconds",
        "apply_not_after_seconds",
        "application_skew_max_seconds",
        "snapshot_delivery_max_seconds",
        "resources"
      ],
      "title": "BoundedTimingPolicy",
      "type": "object"
    },
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "BusLoad": {
      "additionalProperties": false,
      "properties": {
        "bus_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
