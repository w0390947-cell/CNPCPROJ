          "type": "integer"
        },
        "planning_update_seconds": {
          "exclusiveMinimum": 0,
          "title": "Planning Update Seconds",
          "type": "integer"
        },
        "planning_horizon_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Planning Horizon Seconds",
          "type": "integer"
        },
        "response_deadline_seconds": {
          "exclusiveMinimum": 0,
          "title": "Response Deadline Seconds",
          "type": "integer"
        },
        "p_tracking_tolerance_mw": {
          "exclusiveMinimum": 0,
          "title": "P Tracking Tolerance Mw",
