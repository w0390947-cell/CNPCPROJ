        "bus_id",
        "p_mw",
        "q_mvar",
        "scope_ref"
      ],
      "title": "BusLoad",
      "type": "object"
    },
    "ControlPolicy": {
      "additionalProperties": false,
      "properties": {
        "observation_uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationUncertaintyPolicy"
