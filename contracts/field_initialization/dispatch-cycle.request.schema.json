{
  "$defs": {
    "Authority": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Owner Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "permission_revision": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Permission Revision",
          "type": "string"
        },
        "write_enabled": {
          "default": false,
          "title": "Write Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "owner_id",
        "epoch",
        "valid_until",
        "permission_revision"
      ],
      "title": "Authority",
      "type": "object"
    },
    "DispatchRequest": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Context Id",
          "type": "string"
        },
        "command_batch_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Command Batch Id",
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/Authority"
        }
      },
      "required": [
        "context_id",
        "command_batch_id",
        "authority"
      ],
      "title": "DispatchRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interface_version": {
      "const": "single-microgrid-field-v0.1-draft",
      "title": "Interface Version",
      "type": "string"
    },
    "message_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Message Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correlation Id"
    },
    "microgrid_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Microgrid Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "operation": {
      "const": "DispatchControlCycle",
      "title": "Operation",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/DispatchRequest"
    }
