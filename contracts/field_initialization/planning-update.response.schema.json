{
  "$defs": {
    "InterfaceError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "required_action": {
          "default": "Correct the input or resolve the stated prerequisite.",
          "title": "Required Action",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "InterfaceError",
      "type": "object"
    },
    "PlanningUpdatePayload": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "errors": {
          "default": [],
