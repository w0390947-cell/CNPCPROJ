            "$ref": "#/$defs/InterfaceError"
          },
          "title": "Errors",
          "type": "array"
        },
        "data": {
          "$ref": "#/$defs/PlanningUpdateResult"
        }
      },
      "required": [
        "outcome",
        "data"
      ],
      "title": "PlanningUpdatePayload",
      "type": "object"
    },
    "PlanningUpdateResult": {
      "additionalProperties": false,
      "properties": {
        "input_revision": {
          "title": "Input Revision",
          "type": "string"
        },
        "activation_status": {
          "enum": [
            "staged",
            "activated",
            "rejected"
          ],
          "title": "Activation Status",
          "type": "string"
        },
        "new_context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "New Context Id"
        },
        "effective_from": {
          "format": "date-time",
          "title": "Effective From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "preserved_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preserved Task Id"
        },
        "preserved_target_deadline_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preserved Target Deadline At"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Ref"
        },
        "mode": {
          "default": "shadow",
          "enum": [
            "shadow",
            "closed_loop"
          ],
          "title": "Mode",
          "type": "string"
        },
        "dispatch_enabled": {
          "const": false,
          "default": false,
          "title": "Dispatch Enabled",
          "type": "boolean"
        },
        "energy_task_guarantee": {
          "enum": [
            "not_assessed",
            "not_required",
            "maintained",
            "unproven"
          ],
          "title": "Energy Task Guarantee",
          "type": "string"
        }
      },
      "required": [
        "input_revision",
        "activation_status",
        "new_context_id",
        "effective_from",
        "valid_until",
        "preserved_task_id",
        "reason",
        "evidence_ref",
        "energy_task_guarantee"
      ],
      "title": "PlanningUpdateResult",
      "type": "object"
    }
