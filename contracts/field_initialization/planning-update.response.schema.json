      "title": "Operation",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "microgrid_id": {
      "title": "Microgrid Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/PlanningUpdatePayload"
    }
  },
  "required": [
    "message_id",
    "correlation_id",
    "microgrid_id",
    "run_id",
    "created_at",
    "payload"
  ],
  "title": "UpdatePlanningResponse",
  "type": "object"
}
