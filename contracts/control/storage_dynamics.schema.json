        "previous_mw": {
          "title": "Previous Mw",
          "type": "number"
        },
        "requested_mw": {
          "title": "Requested Mw",
          "type": "number"
        },
        "ordinary_mw": {
          "title": "Ordinary Mw",
          "type": "number"
        },
        "actual_mw": {
          "title": "Actual Mw",
          "type": "number"
        },
        "maximum_change_mw": {
          "title": "Maximum Change Mw",
          "type": "number"
        },
        "ordinary_unserved_mw": {
          "title": "Ordinary Unserved Mw",
          "type": "number"
        },
        "physical_override": {
          "title": "Physical Override",
          "type": "boolean"
        },
        "hard_override": {
          "title": "Hard Override",
          "type": "boolean"
        },
        "ramp_compliant": {
