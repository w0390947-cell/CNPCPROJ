          "type": "array"
        }
      },
      "required": [
        "version",
        "complete",
        "records"
      ],
      "title": "StorageDynamicsTrajectory",
      "type": "object"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/StorageDynamicsTrajectory"
  },
  "type": "object"
