              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/StorageDynamicsRecord"
          },
