        "time_hour",
        "aggregate_load_mw",
        "aggregate_renewable_mw",
        "aggregate_import_mw",
        "aggregate_q_mvar",
        "import_limit_mw",
        "regional_import_mw"
      ],
      "title": "ClusterTimeSeriesPoint",
      "type": "object"
    },
    "ClusterValidation": {
      "description": "A reference-only pass never certifies uncomputed execution stages.",
      "properties": {
        "scope": {
          "enum": [
            "reference_only",
            "hierarchical_execution"
          ],
          "title": "Scope",
          "type": "string"
        },
        "assessed_scope_status": {
          "enum": [
            "passed",
            "violated",
            "unknown",
            "not_computed"
          ],
          "title": "Assessed Scope Status",
          "type": "string"
        },
        "execution_status": {
          "enum": [
            "passed",
            "violated",
            "unknown",
            "not_computed"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/ClusterImportAssessment"
          },
          "title": "Stages",
          "type": "array"
        },
        "version": {
          "const": "cluster-validation-v1",
          "default": "cluster-validation-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "assessed_scope_status",
        "execution_status",
        "stages"
      ],
      "title": "ClusterValidation",
      "type": "object"
    },
    "CommunicationEventExecution": {
      "description": "Observed coverage, not a claim that one event alone caused each drop.",
      "properties": {
        "window": {
          "$ref": "#/$defs/CommunicationFaultWindow"
        },
        "status": {
          "enum": [
            "executed",
            "partially_executed",
            "not_reached"
          ],
          "title": "Status",
          "type": "string"
        },
        "observed_ticks": {
          "items": {
            "type": "integer"
          },
          "title": "Observed Ticks",
          "type": "array"
        },
        "matched_messages": {
          "title": "Matched Messages",
          "type": "integer"
        },
        "dropped_while_active": {
          "title": "Dropped While Active",
          "type": "integer"
        }
      },
      "required": [
        "window",
        "status",
        "observed_ticks",
        "matched_messages",
        "dropped_while_active"
      ],
      "title": "CommunicationEventExecution",
      "type": "object"
    },
    "CommunicationFaultWindow": {
      "description": "Inclusive iteration window; packet loss retains explicit global semantics.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "outage",
            "packet_loss"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "enum": [
            "region",
            "global"
          ],
          "title": "Scope",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "probability": {
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "event_id",
        "kind",
        "scope",
        "target",
        "start",
        "end",
        "probability"
      ],
      "title": "CommunicationFaultWindow",
      "type": "object"
    },
    "CommunicationSummary": {
      "additionalProperties": false,
      "properties": {
        "sent": {
          "title": "Sent",
          "type": "integer"
        },
        "delivered": {
          "title": "Delivered",
