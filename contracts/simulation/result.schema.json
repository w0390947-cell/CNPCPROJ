    "ReferenceEconomics": {
      "description": "Aggregate reference accounting, explicitly NOT regional AC realization.",
      "properties": {
        "reference": {
          "$ref": "#/$defs/EconomicCost"
        },
        "centralized_economic_cost_cny": {
          "title": "Centralized Economic Cost Cny",
          "type": "number"
        },
        "surrogate_objective_cny": {
          "title": "Surrogate Objective Cny",
          "type": "number"
        },
        "gap_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gap Percent"
        },
        "comparison_status": {
          "enum": [
            "comparable",
            "not_converged",
            "nonpositive_baseline"
          ],
          "title": "Comparison Status",
          "type": "string"
        },
        "accounting_version": {
