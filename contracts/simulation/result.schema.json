      },
      "required": [
        "iteration",
        "primal_residual",
        "dual_residual",
        "primal_tolerance",
        "dual_tolerance",
        "fresh_region_count",
        "convergence_streak",
        "fallback_regions"
      ],
      "title": "ADMMHistoryPoint",
      "type": "object"
    },
    "ClusterImportAssessment": {
      "properties": {
