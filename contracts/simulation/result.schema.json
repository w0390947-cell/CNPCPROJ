        },
        "aggregate_load_mw": {
          "title": "Aggregate Load Mw",
          "type": "number"
        },
        "aggregate_renewable_mw": {
          "title": "Aggregate Renewable Mw",
          "type": "number"
        },
        "aggregate_import_mw": {
          "title": "Aggregate Import Mw",
          "type": "number"
        },
        "aggregate_q_mvar": {
          "title": "Aggregate Q Mvar",
          "type": "number"
        },
