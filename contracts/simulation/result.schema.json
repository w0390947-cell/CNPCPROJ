    "CoordinationIterationTrace": {
      "additionalProperties": false,
      "description": "Lightweight immutable replay evidence for one communication tick.\n\nEpoch identifies the barrier being collected. References are AFTER this\ntick's projection (unchanged if global_updated is false). Time is a separate\nplanning axis in hours, never a conversion of communication_tick.",
      "properties": {
        "version": {
          "const": "coordination-trace-v1",
          "default": "coordination-trace-v1",
          "title": "Version",
          "type": "string"
        },
        "communication_tick": {
          "minimum": 1,
          "title": "Communication Tick",
          "type": "integer"
        },
        "coordination_epoch": {
          "minimum": 0,
          "title": "Coordination Epoch",
          "type": "integer"
        },
        "global_updated": {
          "title": "Global Updated",
          "type": "boolean"
        },
        "time_hours": {
          "items": {
            "type": "number"
          },
          "title": "Time Hours",
          "type": "array"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/RegionalCoordinationTrace"
          },
          "title": "Regions",
          "type": "array"
        }
      },
      "required": [
        "communication_tick",
        "coordination_epoch",
        "global_updated",
        "time_hours",
        "regions"
      ],
      "title": "CoordinationIterationTrace",
      "type": "object"
    },
    "CoordinationResiduals": {
      "properties": {
        "primal": {
          "title": "Primal",
          "type": "number"
        },
        "dual": {
          "title": "Dual",
          "type": "number"
        },
