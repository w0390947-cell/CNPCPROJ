          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outage Start Iteration"
        },
        "outage_end_iteration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
