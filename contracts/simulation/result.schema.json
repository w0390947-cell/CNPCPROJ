        },
        "dual_tolerance": {
          "title": "Dual Tolerance",
          "type": "number"
        }
      },
      "required": [
        "primal",
        "dual",
        "primal_tolerance",
        "dual_tolerance"
      ],
      "title": "CoordinationResiduals",
      "type": "object"
    },
    "CoordinationSnapshot": {
      "description": "One completed barrier update; row order is the order of `regions`.\n\nThe local plans consumed epoch k, and the new references/duals are for k+1.\n`converged` certifies the aggregate convex problem only, never execution.",
      "properties": {
        "epoch": {
          "title": "Epoch",
          "type": "integer"
        },
        "communication_tick": {
          "title": "Communication Tick",
          "type": "integer"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "capabilities": {
          "$ref": "#/$defs/DispatchCapabilities"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/RegionalPlanSnapshot"
          },
          "title": "Regions",
          "type": "array"
        },
        "p_references_mw": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "P References Mw",
          "type": "array"
        },
        "q_references_mvar": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Q References Mvar",
          "type": "array"
        },
        "previous_p_references_mw": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Previous P References Mw",
          "type": "array"
        },
        "previous_q_references_mvar": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Previous Q References Mvar",
          "type": "array"
        },
        "dual_p": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Dual P",
          "type": "array"
        },
        "dual_q": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Dual Q",
          "type": "array"
        },
        "rho": {
          "title": "Rho",
          "type": "number"
        },
        "residuals": {
          "$ref": "#/$defs/CoordinationResiduals"
        },
        "version": {
          "const": "coordination-snapshot-v1",
          "default": "coordination-snapshot-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "epoch",
        "communication_tick",
        "converged",
        "capabilities",
        "regions",
        "p_references_mw",
        "q_references_mvar",
        "previous_p_references_mw",
        "previous_q_references_mvar",
        "dual_p",
        "dual_q",
        "rho",
        "residuals"
      ],
      "title": "CoordinationSnapshot",
      "type": "object"
    },
    "DispatchCapabilities": {
      "description": "One dispatch request's device participation, not physical nameplate data.\n\nDisabled storage provides neither active nor reactive support, matching\nexisting central solvers. Its initial energy is held fixed.",
