        "limit_mw": {
          "title": "Limit Mw",
          "type": "number"
        },
        "tolerance_mw": {
          "title": "Tolerance Mw",
          "type": "number"
        },
        "peak_import_mw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Peak Import Mw"
        },
