{
  "$defs": {
    "ADMMHistoryPoint": {
      "additionalProperties": false,
      "properties": {
        "iteration": {
          "title": "Iteration",
          "type": "integer"
        },
        "primal_residual": {
          "title": "Primal Residual",
          "type": "number"
        },
        "dual_residual": {
          "title": "Dual Residual",
          "type": "number"
        },
        "primal_tolerance": {
          "title": "Primal Tolerance",
          "type": "number"
        },
        "dual_tolerance": {
          "title": "Dual Tolerance",
          "type": "number"
        },
        "fresh_region_count": {
          "title": "Fresh Region Count",
          "type": "integer"
        },
        "convergence_streak": {
          "title": "Convergence Streak",
          "type": "integer"
        },
        "fallback_regions": {
          "items": {
            "type": "string"
          },
          "title": "Fallback Regions",
          "type": "array"
        },
        "coordination": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoordinationIterationTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
