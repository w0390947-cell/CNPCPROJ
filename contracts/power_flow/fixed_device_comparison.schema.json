        "x_pu": {
          "title": "X Pu",
          "type": "number"
        },
        "s_max_mva": {
          "title": "S Max Mva",
          "type": "number"
        },
        "normally_in_service": {
          "default": true,
          "title": "Normally In Service",
          "type": "boolean"
